###############################
#[backend]
###############################
# Copy to `.env.local` (gitignored). Group headers are required so env.split
# can bake these vars into `.output/env.compose.backend` for Docker Compose.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DROPBOX_OAUTH_APP_KEY=
DROPBOX_OAUTH_APP_SECRET=

# Compose sets CHIEF_LOCAL_DIR=/mnt/local on backend, worker, and Beat; only
# Beat scheduling and worker task execution drive reconciliation.
# Repo `.local/` (Compose mount source) may be a symlink to a private checkout
# (agents/, keys/, evals/); host-side `orunr eval` also reads that overlay.

# Fernet master key for encrypted credentials (apps.keys). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Optional in dev (DEBUG=True) — uses settingsbase dev default when unset.
CREDENTIALS_KEY=

# Compose bakes a well-known OBSIDIAN_VAULT_TOKEN from
# `.env.development.compose` (`#[backend,obsidian]`) into both backend and
# vault-service env files so `.env.local` is not required. Optional override:
# #[backend,obsidian]
# OBSIDIAN_VAULT_TOKEN=<non-empty>
# Do not assign a blank value — later files win in env.split and would wipe
# the compose default. OBSIDIAN_VAULT_URL is set by Compose
# (http://chief-obsidian:8100); only override it here if running the backend
# outside Compose.
