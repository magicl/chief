###############################
#[backend]
###############################
# Copy to `.env.local` (gitignored). Group headers are required so env.split
# can bake these vars into `.output/env.compose.backend` for Docker Compose.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DROPBOX_OAUTH_APP_KEY=
DROPBOX_OAUTH_APP_SECRET=

# Compose sets CHIEF_LOCAL_DIR=/mnt/local on backend, worker, and Beat; only
# Beat scheduling and worker task execution drive reconciliation.
# Repo `.local/` (Compose mount source) may be a symlink to a private checkout
# (agents/, keys/, evals/); host-side `orunr eval` also reads that overlay.

# Fernet master key for encrypted credentials (apps.keys). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Optional in dev (DEBUG=True) — uses settingsbase dev default when unset.
CREDENTIALS_KEY=

# Inter-service bearer token shared between the backend/worker/Beat and the
# chief-obsidian vault service. Compose injects this same value into both,
# but via separate minimal env files (see `#[backend,obsidian]` below) so the
# vault container never receives Postgres/CREDENTIALS_KEY/other backend
# secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# OBSIDIAN_VAULT_URL is set automatically by Compose (http://chief-obsidian:8100);
# only override it here if running the backend outside Compose.
###############################
#[backend,obsidian]
###############################
OBSIDIAN_VAULT_TOKEN=
